{
  "fs_read": [
    ".",
    "/usr",
    "/lib",
    "/lib64",
    "/etc",
    "~/.local/share/pnpm",
    "~/.config/pnpm"
  ],
  "fs_write": [
    "."
  ],
  "net_allow": [
    "registry.npmjs.org",
    "raw.githubusercontent.com"
  ],
  "net_deny": [
    "*"
  ],
  "env": [
    "PATH",
    "HOME",
    "USER",
    "SHELL",
    "TERM",
    "LANG"
  ]
}

